{
  "name": "tidepost",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @starter/client dev",
    "dev:auto": "node scripts/dev.mjs --auto",
    "build": "pnpm --filter @starter/shared run build && pnpm --filter @starter/client run build",
    "build:client": "pnpm --filter @starter/shared run build && pnpm --filter @starter/client run build",
    "test": "pnpm run test:client",
    "test:client": "pnpm --filter @starter/client run test",
    "dev:infra": "docker-compose -f docker-compose.dev.yml up -d",
    "dev:infra:stop": "docker-compose -f docker-compose.dev.yml down",
    "dev:infra:reset": "docker-compose -f docker-compose.dev.yml down -v",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "backup:status": "hatchkit backup status --project tidepost",
    "backup:list": "hatchkit backup snapshots --project tidepost",
    "backup:restore": "hatchkit backup restore --project tidepost"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "mongodb": "^7.7.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {},
  "description": "Self-hosted Instagram scheduler that runs on your own Cloudflare account."
}
