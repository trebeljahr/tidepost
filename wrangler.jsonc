{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidepost",
  "main": "packages/worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./packages/client/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  // Created on first deploy (no ids needed). D1: posts, settings, passkeys. KV: photos until they are published.
  "d1_databases": [{ "binding": "DB", "database_name": "tidepost", "migrations_dir": "packages/worker/migrations" }],
  "kv_namespaces": [{ "binding": "PHOTOS" }],
  // One trigger every minute: publishing, daily token refresh and grid sync all run from it.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": { "GRAPH_BASE": "https://graph.instagram.com/v27.0" }
}
